# Only what ships is tracked: the plugin manifest, the skills, README, LICENSE and CI.
# Maintainer-only files stay on the maintainer's machine:
#   dev/  long-lived work (plans, workbench, test images and films, tools, release drafts)
#   tmp/  scratch that can be wiped at any time
/dev/
/tmp/
/work/
/.claude/
/*
!/.gitignore
!/.claude-plugin/
!/.github/
!/skills/
!/README.md
!/README.zh-CN.md
!/LICENSE
!/SECURITY.md
!/CITATION.cff

# runtime and local data inside the skills
node_modules/
__pycache__/
*.pyc
.DS_Store
models/
history.jsonl
consent.json
*.log
